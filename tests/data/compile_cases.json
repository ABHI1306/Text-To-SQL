{
  "version": "v0",
  "status": "draft_pending_human_review",
  "dialect": "postgresql",
  "source_note": "Day 3 starter set. The compiler (Day 4) does not exist yet; 'expect' describes compiled structure, not exact SQL. Model names come from the deployed E-commerce sample MDL. v1 (40 cases, Day 4) extends this file after DBA review.",
  "model_overlay": {
    "calculated_fields": [
      {
        "model": "order_items",
        "name": "line_total",
        "expression": "quantity * unit_price"
      }
    ],
    "metrics": [
      {
        "name": "monthly_revenue",
        "base_model": "order_items",
        "dimensions": [
          {
            "name": "order_month",
            "expression": "date_trunc('month', ordered_at)",
            "via": "orders"
          }
        ],
        "measures": [
          {
            "name": "revenue",
            "expression": "sum(quantity * unit_price)"
          }
        ]
      }
    ],
    "row_policies": [
      {
        "name": "orders_region",
        "model": "orders",
        "predicate": "region = {{ user.region }}"
      },
      {
        "name": "customers_region",
        "model": "customers",
        "predicate": "region = {{ user.region }}"
      }
    ],
    "users": {
      "eu_user": {
        "region": "EU"
      },
      "no_region_user": {}
    }
  },
  "cases": [
    {
