APP_ENV=development
LOG_LEVEL=INFO
METADATA_HOST_PORT=55432
DEMO_HOST_PORT=55433
METADATA_ADMIN_PASSWORD=local_metadata_admin_change_me
METADATA_APP_PASSWORD=local_metadata_app_change_me
DEMO_ADMIN_PASSWORD=local_demo_admin_change_me
WAREHOUSE_READER_PASSWORD=local_warehouse_reader_change_me
WAREHOUSE_STATEMENT_TIMEOUT_MS=10000
WAREHOUSE_MAX_ROWS=1000
JWT_SECRET=
CONNECTION_ENCRYPTION_KEY=
BOOTSTRAP_DBA_USERNAME=demo.dba
BOOTSTRAP_DBA_PASSWORD=
DB_HOST_ALLOWLIST=demo-db,localhost,127.0.0.1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=28800
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
SQL_MODEL=llama3:latest
SMALL_MODEL=
EMBEDDING_MODEL=nomic-embed-text:latest

QDRANT_HOST=localhost
QDRANT_PORT=6333

OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# These are local-development placeholders. Replace them before sharing or deployment.

# LDAP login (optional). Leave LDAP_URI empty for local accounts only.
# LDAPS or StartTLS is required; LDAP_ALLOW_INSECURE=true is for tests only.
LDAP_URI=
LDAP_START_TLS=false
LDAP_CA_CERT_FILE=
LDAP_SERVICE_DN=
LDAP_SERVICE_PASSWORD=
LDAP_USER_BASE_DN=
LDAP_USER_FILTER=(uid={username})
LDAP_GROUP_BASE_DN=
LDAP_GROUP_FILTER=(member={dn})
# directory attribute = row-policy attribute, comma separated, e.g. l=region,departmentNumber=department
LDAP_ATTRIBUTE_MAP=
# identity-demo profile (OpenLDAP) passwords
LDAP_ADMIN_PASSWORD=

# OpenID Connect login (optional). Leave OIDC_ISSUER empty to disable it.
# Authorization code flow with PKCE; issuer, discovery URL and redirect URI must be https
# unless OIDC_ALLOW_INSECURE=true (local Keycloak demo only).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Only when the API reaches the provider at a different address than browsers do (containers)
OIDC_DISCOVERY_URL=
OIDC_SCOPES=openid profile email
OIDC_USERNAME_CLAIM=preferred_username
# claim holding group names; a dotted path reads nested claims, e.g. realm_access.roles
OIDC_GROUPS_CLAIM=groups
# ID-token claim = row-policy attribute, comma separated, e.g. region=region,department=department
OIDC_ATTRIBUTE_MAP=
OIDC_ALLOW_INSECURE=false
# identity-demo profile (Keycloak, docker-compose.oidc.yml)
KEYCLOAK_ADMIN_PASSWORD=

# Worker scheduler
SCHEDULER_POLL_SECONDS=15
RESULT_CACHE_SECONDS=300
SCHEDULER_LEASE_SECONDS=300
SCHEDULER_WORKER_ID=
