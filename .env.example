APP_ENV=development
LOG_LEVEL=INFO
METADATA_HOST_PORT=55432
DEMO_HOST_PORT=55433
METADATA_ADMIN_PASSWORD=local_metadata_admin_change_me
METADATA_APP_PASSWORD=local_metadata_app_change_me
DEMO_ADMIN_PASSWORD=local_demo_admin_change_me
WAREHOUSE_READER_PASSWORD=local_warehouse_reader_change_me
WAREHOUSE_STATEMENT_TIMEOUT_MS=10000
WAREHOUSE_MAX_ROWS=1000
JWT_SECRET=
CONNECTION_ENCRYPTION_KEY=
BOOTSTRAP_DBA_USERNAME=demo.dba
BOOTSTRAP_DBA_PASSWORD=
DB_HOST_ALLOWLIST=demo-db,localhost,127.0.0.1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=28800
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
SQL_MODEL=llama3:latest
EMBEDDING_MODEL=nomic-embed-text:latest

QDRANT_HOST=localhost
QDRANT_PORT=6333

OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# These are local-development placeholders. Replace them before sharing or deployment.

# LDAP login (optional). Leave LDAP_URI empty for local accounts only.
# LDAPS or StartTLS is required; LDAP_ALLOW_INSECURE=true is for tests only.
LDAP_URI=
LDAP_START_TLS=false
LDAP_CA_CERT_FILE=
LDAP_SERVICE_DN=
LDAP_SERVICE_PASSWORD=
LDAP_USER_BASE_DN=
LDAP_USER_FILTER=(uid={username})
LDAP_GROUP_BASE_DN=
LDAP_GROUP_FILTER=(member={dn})
# directory attribute = row-policy attribute, comma separated, e.g. l=region,departmentNumber=department
LDAP_ATTRIBUTE_MAP=
# identity-demo profile (OpenLDAP) passwords
LDAP_ADMIN_PASSWORD=
